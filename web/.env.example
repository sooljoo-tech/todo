# Supabase 연동 (비워두면 브라우저 localStorage 모드로만 동작)
# Supabase 대시보드 > Project Settings > API 에서 확인
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 로그인 허용 도메인 (쉼표 구분). supabase/schema.sql 의 allowed_email_domains() 와 같게 유지
VITE_ALLOWED_DOMAINS=joomidang.com

# 푸시 알림용 VAPID 공개키 (scripts/gen-vapid.mjs 로 생성)
VITE_VAPID_PUBLIC_KEY=
